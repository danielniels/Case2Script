            # Step 6: Screenshot
            print('>> STEP 6')
            await page.screenshot(path=f'{SCREENSHOT_DIR}/step_6.png')

            # Step 7: Verifikasi input field First Name berisi manda
            print('>> STEP 7')
            t = (await page.locator('//label[normalize-space(.)="First Name"]/following::input[1]').first.input_value()).strip()
